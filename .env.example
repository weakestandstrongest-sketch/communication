# ─────────────────────────────────────────────────────────────────────────────
# つどい environment variables. Copy to .env.local for local development and set
# the same names in Vercel (Project → Settings → Environment Variables) for production.
# Never commit real secrets. Only NEXT_PUBLIC_* values are sent to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project (Dashboard → Project Settings → API / API Keys)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_...). The legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: used by /api/push/* to read subscriptions. Secret key (sb_secret_...) or legacy service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (generate with: npm run vapid). Without these, the in-app notification center still works.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:you@example.com
VAPID_SUBJECT=mailto:admin@example.com

# Shared secret the database uses to call /api/push/dispatch (any long random string, e.g. `openssl rand -hex 32`).
# The same value must be stored in the database with private.set_push_config(...) — see docs/NOTIFICATIONS.md.
PUSH_DISPATCH_SECRET=

# Only for running Google login against the LOCAL Supabase stack (supabase/config.toml).
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
